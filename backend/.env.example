# どちらで Gemini を呼ぶか: aistudio（検証用） / vertex（本番）
GEMINI_PROVIDER=aistudio

# 検証用: Google AI Studio で発行した API キー
GEMINI_API_KEY=

# 本番用: GCP の API キー（Vertex AI と Speech-to-Text を許可したもの）
GOOGLE_CLOUD_API_KEY=

# モデル（`npm run check` で使えるモデル一覧を確認できる）
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# #10: 話題がこの件数を超えたら埋め込みで候補を絞る（0 にすると常に絞り込む）
TOPIC_FULL_SCAN_LIMIT=30

# #6: Speech-to-Text の設定（GCP のキーが必要）
STT_LANGUAGE=ja-JP

PORT=8787
