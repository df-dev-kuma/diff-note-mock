{
  "name": "diff-note-backend",
  "version": "1.0.0",
  "description": "食い違い検知のバックエンド（Gemini 呼び出し #1〜#10）",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsx scripts/check.ts",
    "scenario": "tsx scripts/scenario.ts",
    "eval:classify": "tsx scripts/eval-classify.ts",
    "try": "tsx scripts/try.ts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test test/*.test.ts",
    "build:lab": "esbuild lab/main.ts --bundle --format=esm --platform=browser --target=es2022 --minify --sourcemap --outfile=dist-lab/main.js && cp lab/index.html dist-lab/index.html",
    "dev:lab": "npm run build:lab && esbuild lab/main.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=dist-lab/main.js --servedir=dist-lab --watch"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
